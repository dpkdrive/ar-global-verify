# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=development
API_VERSION=v1

# ==========================================
# MongoDB
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/ar_blobal_v1

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# Client / Cookies
# ==========================================
CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

VERIFICATION_RATE_LIMIT_WINDOW_MS=600000
VERIFICATION_RATE_LIMIT_MAX=20

# Mark a product as suspicious after this many successful manual verifications.
SUSPICIOUS_VERIFICATION_THRESHOLD=10

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info

# ==========================================
# Authentication Code Generation (defaults)
# ==========================================
AUTH_CODE_SECRET=change_this_hmac_secret_for_code_hashing

# ==========================================
# Initial Administrator (used only by npm run seed:admin)
# ==========================================
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_12_character_minimum_password
